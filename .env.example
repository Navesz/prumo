# Prumo — copy to .env and fill in. The server REFUSES to boot when a required
# variable is missing, and it names the one that is missing.
#
# Generate the two secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# --- required -----------------------------------------------------------------

# Postgres connection string. These are the compose defaults, meant to be replaced.
# Inside the compose network the app builds its own URL from POSTGRES_PASSWORD;
# this value is what `npm run dev` and the test suite use from the host.
DATABASE_URL=postgres://prumo:prumo@localhost:5432/prumo # alicerce-segredo-ok: template, valor falso

# Key-encryption key: 32 bytes, base64. Every user API key in the database is
# unusable without it.
#
# LOSING THIS IS IRREVERSIBLE. Every stored provider key becomes unreadable.
# Keep an offline copy somewhere DIFFERENT from your database backup — if the
# two sit together, encryption at rest was decoration.
PRUMO_KEK=

# Pepper for the key fingerprint HMAC: 32 bytes, base64. Lets the server detect a
# duplicate key without decrypting anything. Losing it costs the duplicate check,
# not the keys.
PRUMO_PEPPER=

# --- optional -----------------------------------------------------------------

# api | worker | tudo   (default: tudo)
# One binary serves HTTP, the worker and SSE. Split it into two containers by
# running the same image twice with different roles — it is a compose line, not
# a refactor.
PRUMO_PAPEL=tudo

# pessoal | publico    (default: pessoal)
# "pessoal" closes registration after the first account is created.
PRUMO_MODO=pessoal

PORT=3000
HOST=0.0.0.0

# Public origin, used only to register provider webhooks. Leave empty when the
# server is behind NAT: no webhook is registered and polling covers everything.
PRUMO_URL_PUBLICA=

# disco | s3          (default: disco)
PRUMO_ARMAZENAMENTO=disco
PRUMO_DIR_BLOBS=./var/blobs

# trace | debug | info | warn | error   (default: info)
LOG_LEVEL=info
